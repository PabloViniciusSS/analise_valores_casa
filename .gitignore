# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.eggs/
*.egg-info/

# ==========================
# Virtual Environment
# ==========================
venv/
.env/
.venv/

# ==========================
# Environment Variables
# ==========================
.env

# ==========================
# Jupyter Notebook
# ==========================
.ipynb_checkpoints

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# Data (não versionar datasets locais)
# ==========================
data/raw/*
data/staging/*
data/processed/*

# Permitir estrutura das pastas
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/processed/.gitkeep

# ==========================
# Model Artifacts
# ==========================
models_artifacts/*
!models_artifacts/.gitkeep

# ==========================
# Reports gerados
# ==========================
reports/figures/*
reports/metrics/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep

# ==========================
# IDE
# ==========================
.vscode/
.idea/

# ==========================
